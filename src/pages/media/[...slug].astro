---
// /media/<slug> — one event photo post: header, photo grid, markdown
// description, and a full-screen viewer (native <dialog>, no library).
// Data comes from the `media` collection; photos are WebP files the CMS
// already resized at upload, so they are served as-is from /images/uploads.
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CategoryTag from '../../components/CategoryTag.astro';
import Icon from '../../components/Icon.astro';
import { formatDate } from '../../lib/content';

export async function getStaticPaths() {
  const entries = await getCollection('media', ({ data }) =>
    import.meta.env.DEV ? true : !data.draft,
  );
  return entries.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();
const { title, description, pubDate, images } = entry.data;
const count = images.length;
const altFor = (i: number) => images[i].caption || `${title} — photo ${i + 1}`;
---
<BaseLayout title={title} description={description} active="/media">
  <article class="mx-auto max-w-4xl">
    <a
      href="/media"
      class="group mb-6 inline-flex items-center gap-1.5 text-sm font-medium text-navy/55 hover:text-teal active:text-ink dark:text-mist/55 dark:hover:text-teal"
    >
      <span class="transition-transform duration-200 ease-spring group-hover:-translate-x-0.5">
        <Icon name="arrow" class="w-4 h-4 rotate-180" />
      </span>
      Back to media
    </a>

    <header class="max-w-3xl">
      <div class="mb-3 flex flex-wrap items-center gap-3">
        <CategoryTag category="Media" />
        <span class="flex items-center gap-1.5 text-xs text-navy/50 dark:text-mist/50">
          <Icon name="clock" class="w-3.5 h-3.5" />
          {formatDate(pubDate)}
          {count > 0 && <span aria-hidden="true">·</span>}
          {count > 0 && <span>{count} {count === 1 ? 'photo' : 'photos'}</span>}
        </span>
      </div>
      <h1 class="text-3xl font-extrabold leading-[1.1] tracking-tightest text-ink dark:text-paper sm:text-[2.6rem]">
        {title}
      </h1>
      <p class="mt-4 text-lg leading-relaxed text-navy/65 dark:text-mist/65">{description}</p>
    </header>

    {count > 0 ? (
      <ul class="my-8 grid grid-cols-2 gap-3 sm:grid-cols-3" role="list">
        {images.map((img, i) => (
          <li>
            <button
              type="button"
              class="gallery-thumb group relative block aspect-square w-full overflow-hidden rounded-2xl shadow-card ring-1 ring-ink/5 transition-transform duration-300 ease-spring hover:-translate-y-0.5 active:scale-[0.98] dark:ring-white/5"
              data-index={i}
              data-src={img.src}
              data-caption={img.caption ?? ''}
              aria-label={`Open photo ${i + 1} of ${count}${img.caption ? `: ${img.caption}` : ''}`}
            >
              <img
                src={img.src}
                alt={altFor(i)}
                loading={i < 3 ? 'eager' : 'lazy'}
                decoding="async"
                class="h-full w-full object-cover transition-transform duration-500 ease-spring group-hover:scale-[1.04]"
              />
              <span class="pointer-events-none absolute inset-0 bg-gradient-to-t from-ink/60 via-transparent to-transparent"></span>
              <span class="pointer-events-none absolute inset-0 bg-teal/10 mix-blend-multiply"></span>
              {img.caption && (
                <span class="pointer-events-none absolute inset-x-0 bottom-0 line-clamp-2 p-3 text-left text-xs font-medium leading-snug text-paper">
                  {img.caption}
                </span>
              )}
            </button>
          </li>
        ))}
      </ul>
    ) : (
      <p class="my-8 rounded-2xl border border-dashed border-ink/15 p-8 text-center text-sm text-navy/55 dark:border-white/10 dark:text-mist/55">
        No photos in this post yet.
      </p>
    )}

    <div class="prose-niko max-w-3xl dark:text-mist/80">
      <Content />
    </div>
  </article>

  {count > 0 && (
    <dialog
      id="photo-viewer"
      aria-label="Photo viewer"
      class="m-0 h-full max-h-none w-full max-w-none bg-transparent p-4 text-paper backdrop:bg-ink/90 backdrop:backdrop-blur-sm open:flex open:flex-col open:items-center open:justify-center sm:p-8"
    >
      <button
        type="button"
        data-viewer="close"
        aria-label="Close photo viewer"
        class="absolute right-4 top-4 grid h-11 w-11 place-items-center rounded-full bg-white/10 ring-1 ring-white/20 transition-transform duration-200 ease-spring hover:bg-white/20 active:scale-95 sm:right-6 sm:top-6"
      >
        <Icon name="close" />
      </button>

      <figure class="flex max-h-full w-full max-w-5xl flex-col items-center gap-4">
        <img
          data-viewer="image"
          src={images[0].src}
          alt={altFor(0)}
          class="max-h-[72vh] max-w-full rounded-xl object-contain shadow-floating"
        />
        <div class="flex w-full max-w-lg items-center justify-between gap-4">
          <button
            type="button"
            data-viewer="prev"
            aria-label="Previous photo"
            class="grid h-11 w-11 shrink-0 place-items-center rounded-full bg-white/10 ring-1 ring-white/20 transition-transform duration-200 ease-spring hover:bg-white/20 active:scale-95"
          >
            <Icon name="arrow" class="w-5 h-5 rotate-180" />
          </button>
          <figcaption class="min-w-0 flex-1 text-center" aria-live="polite">
            <span data-viewer="caption" class="block text-sm leading-relaxed text-mist"></span>
            <span data-viewer="counter" class="mt-1 block text-xs font-semibold tracking-wide text-mist/60"></span>
          </figcaption>
          <button
            type="button"
            data-viewer="next"
            aria-label="Next photo"
            class="grid h-11 w-11 shrink-0 place-items-center rounded-full bg-white/10 ring-1 ring-white/20 transition-transform duration-200 ease-spring hover:bg-white/20 active:scale-95"
          >
            <Icon name="arrow" class="w-5 h-5" />
          </button>
        </div>
      </figure>
    </dialog>
  )}
</BaseLayout>

<script>
  // Full-screen photo viewer. Photo data is read from the grid buttons'
  // data-src / data-caption, so the markup stays the single source of truth.
  const dialog = document.getElementById('photo-viewer') as HTMLDialogElement | null;
  const thumbs = Array.from(document.querySelectorAll<HTMLButtonElement>('.gallery-thumb'));

  if (dialog && thumbs.length) {
    const image = dialog.querySelector<HTMLImageElement>('[data-viewer="image"]')!;
    const caption = dialog.querySelector<HTMLElement>('[data-viewer="caption"]')!;
    const counter = dialog.querySelector<HTMLElement>('[data-viewer="counter"]')!;
    const prev = dialog.querySelector<HTMLButtonElement>('[data-viewer="prev"]')!;
    const next = dialog.querySelector<HTMLButtonElement>('[data-viewer="next"]')!;
    const close = dialog.querySelector<HTMLButtonElement>('[data-viewer="close"]')!;
    let current = 0;
    let opener: HTMLButtonElement | null = null;

    // The `hidden` class, not the hidden attribute: these elements carry
    // Tailwind display classes (grid/block) that would override the attribute.
    const single = thumbs.length === 1;
    prev.classList.toggle('hidden', single);
    next.classList.toggle('hidden', single);

    function show(index: number) {
      current = (index + thumbs.length) % thumbs.length;
      const thumb = thumbs[current];
      const text = thumb.dataset.caption ?? '';
      image.src = thumb.dataset.src ?? '';
      image.alt = thumb.querySelector('img')?.alt ?? '';
      caption.textContent = text;
      caption.classList.toggle('hidden', !text);
      counter.textContent = `${current + 1} / ${thumbs.length}`;
    }

    thumbs.forEach((thumb, i) => {
      thumb.addEventListener('click', () => {
        opener = thumb;
        show(i);
        dialog.showModal();
        document.documentElement.classList.add('overflow-hidden');
      });
    });

    prev.addEventListener('click', () => show(current - 1));
    next.addEventListener('click', () => show(current + 1));
    close.addEventListener('click', () => dialog.close());

    dialog.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') show(current - 1);
      if (e.key === 'ArrowRight') show(current + 1);
    });

    // A click on the dark area around the photo (the dialog itself) closes it.
    dialog.addEventListener('click', (e) => {
      if (e.target === dialog) dialog.close();
    });

    // Fires for Esc, the close button, and backdrop clicks alike.
    dialog.addEventListener('close', () => {
      document.documentElement.classList.remove('overflow-hidden');
      opener?.focus();
    });
  }
</script>
