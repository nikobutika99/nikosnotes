---
import BaseLayout from '../layouts/BaseLayout.astro';
import TopBar from '../components/TopBar.astro';
import Icon from '../components/Icon.astro';
import { site } from '../site';
import about from '../data/about.json';

// About content is editable in the CMS at /admin → "About Page".
const { portrait, headline, linkedin, experience, education, skills, hobbies, certifications } = about;
// Story is one text field; split it into paragraphs on blank/new lines.
const storyParagraphs = (about.story || '')
  .split(/\n+/)
  .map((p) => p.trim())
  .filter(Boolean);
---
<BaseLayout title="About" active="/about">
  <TopBar title="About" subtitle="Who I am." showSearch={false} />

  <!-- About me -->
  <section class="flex flex-col gap-6 sm:flex-row sm:items-start sm:gap-8">
    <div class="relative shrink-0">
      <div class="absolute -inset-2 -z-10 rounded-3xl bg-gradient-to-br from-teal/20 to-growth/20 blur-lg"></div>
      <img
        src={portrait}
        alt={site.author}
        class="h-40 w-40 rounded-2xl object-cover shadow-floating ring-1 ring-ink/5 sm:h-48 sm:w-48"
      />
    </div>
    <div class="max-w-2xl">
      <p class="text-sm font-semibold uppercase tracking-[0.18em] text-growth">About me</p>
      <h2 class="mt-2 text-2xl font-extrabold leading-tight tracking-tightest text-ink dark:text-paper sm:text-3xl">
        {headline}
      </h2>
      <div class="mt-3 space-y-2.5 text-[0.95rem] text-navy/70 dark:text-mist/70">
        {storyParagraphs.map((p) => <p class="leading-relaxed">{p}</p>)}
      </div>
      <div class="mt-6 flex items-center gap-3">
        <a
          href={`mailto:${site.email}`}
          class="inline-flex items-center gap-2 rounded-full bg-ink px-5 py-2.5 text-sm font-semibold text-paper transition-all duration-200 ease-spring hover:-translate-y-0.5 hover:bg-teal active:translate-y-0 focus-visible:ring-2 focus-visible:ring-teal dark:bg-paper dark:text-ink dark:hover:bg-teal dark:hover:text-paper"
        >
          Get in touch
          <Icon name="arrow" class="w-4 h-4" />
        </a>
        {linkedin && (
          <a
            href={linkedin}
            target="_blank"
            rel="noopener noreferrer"
            aria-label="Connect on LinkedIn"
            class="grid h-11 w-11 place-items-center rounded-full bg-white text-[#0A66C2] shadow-card ring-1 ring-ink/5 transition-all duration-200 ease-spring hover:-translate-y-0.5 hover:bg-[#0A66C2] hover:text-white active:translate-y-0 focus-visible:ring-2 focus-visible:ring-teal dark:bg-navy dark:ring-white/5"
          >
            <svg viewBox="0 0 24 24" fill="currentColor" class="h-5 w-5" aria-hidden="true">
              <path d="M20.45 20.45h-3.56v-5.57c0-1.33-.03-3.04-1.85-3.04-1.86 0-2.14 1.45-2.14 2.94v5.67H9.34V9h3.42v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.45v6.29zM5.34 7.43a2.07 2.07 0 1 1 0-4.13 2.07 2.07 0 0 1 0 4.13zM7.12 20.45H3.56V9h3.56v11.45zM22.22 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.22.79 24 1.77 24h20.45c.98 0 1.78-.78 1.78-1.73V1.73C24 .77 23.2 0 22.22 0z"/>
            </svg>
          </a>
        )}
      </div>
    </div>
  </section>

  <div class="mt-12 grid grid-cols-1 gap-8 lg:grid-cols-[1.4fr_1fr]">
    <!-- Left: Experience + Education -->
    <div class="space-y-10">
      <section>
        <h3 class="mb-5 font-display text-xl font-bold text-ink dark:text-paper">Experience</h3>
        <ol class="relative border-l-2 border-ink/10 pl-6 dark:border-white/10">
          {experience.map((e) => (
            <li class="relative mb-7 last:mb-0">
              <span class="absolute -left-[31px] top-1 grid h-4 w-4 place-items-center rounded-full bg-growth ring-4 ring-mist dark:ring-ink"></span>
              <div class="flex flex-wrap items-baseline justify-between gap-x-3">
                <h4 class="font-bold text-ink dark:text-paper">{e.role}</h4>
                <span class="text-xs font-medium text-navy/45 dark:text-mist/45">{e.period}</span>
              </div>
              <p class="text-sm font-semibold text-teal">{e.org}</p>
              <p class="mt-1.5 text-sm leading-relaxed text-navy/60 dark:text-mist/55">{e.detail}</p>
            </li>
          ))}
        </ol>
      </section>

      <section>
        <h3 class="mb-5 font-display text-xl font-bold text-ink dark:text-paper">Education</h3>
        <ol class="relative border-l-2 border-ink/10 pl-6 dark:border-white/10">
          {education.map((e) => (
            <li class="relative mb-7 last:mb-0">
              <span class="absolute -left-[31px] top-1 grid h-4 w-4 place-items-center rounded-full bg-teal ring-4 ring-mist dark:ring-ink"></span>
              <div class="flex flex-wrap items-baseline justify-between gap-x-3">
                <h4 class="font-bold text-ink dark:text-paper">{e.degree}</h4>
                <span class="text-xs font-medium text-navy/45 dark:text-mist/45">{e.period}</span>
              </div>
              <p class="text-sm font-semibold text-teal">{e.school}</p>
              <p class="mt-1.5 text-sm leading-relaxed text-navy/60 dark:text-mist/55">{e.detail}</p>
            </li>
          ))}
        </ol>
      </section>
    </div>

    <!-- Right: Skills + Hobbies + Certifications -->
    <div>
      <section>
        <h3 class="mb-5 font-display text-xl font-bold text-ink dark:text-paper">Skills</h3>
        <div class="flex flex-wrap gap-2">
          {skills.map((s) => (
            <span class="rounded-full bg-white px-3.5 py-2 text-sm font-medium text-navy shadow-card ring-1 ring-ink/[0.04] dark:bg-navy dark:text-mist dark:ring-white/5">
              {s}
            </span>
          ))}
        </div>
      </section>

      <section>
        <h3 class="mb-4 mt-8 font-display text-xl font-bold text-ink dark:text-paper">Hobbies</h3>
        <div class="flex flex-wrap gap-2">
          {hobbies.map((h) => (
            <span class="rounded-full bg-teal/10 px-3.5 py-2 text-sm font-medium text-teal">{h}</span>
          ))}
        </div>
      </section>

      <section>
        <h3 class="mb-4 mt-8 font-display text-xl font-bold text-ink dark:text-paper">Certifications</h3>
        <ul class="space-y-2.5">
          {certifications.map((c) => (
            <li class="flex items-start gap-3 rounded-2xl bg-white p-4 shadow-card ring-1 ring-ink/[0.04] transition-all duration-200 ease-spring hover:-translate-y-0.5 hover:shadow-floating dark:bg-navy dark:ring-white/5">
              <span class="mt-0.5 grid h-9 w-9 shrink-0 place-items-center rounded-xl bg-growth/15 text-growth">
                <Icon name="badge" class="w-5 h-5" />
              </span>
              <div>
                <p class="font-semibold text-ink dark:text-paper">{c.title}</p>
                <p class="text-xs text-navy/55 dark:text-mist/55">{c.issuer} · {c.year}</p>
              </div>
            </li>
          ))}
        </ul>
      </section>
    </div>
  </div>
</BaseLayout>
