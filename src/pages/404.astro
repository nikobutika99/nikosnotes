---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
---
<BaseLayout title="Page not found" active="/">
  <div class="grid min-h-[60vh] place-items-center text-center">
    <div>
      <p class="font-display text-7xl font-extrabold tracking-tightest text-teal">404</p>
      <h1 class="mt-3 text-2xl font-bold text-ink dark:text-paper">This page wandered off.</h1>
      <p class="mt-2 text-sm text-navy/55 dark:text-mist/55">
        The note you're looking for doesn't exist (or moved).
      </p>
      <a
        href="/"
        class="mt-6 inline-flex items-center gap-2 rounded-full bg-growth px-5 py-2.5 text-sm font-semibold text-ink shadow-glow transition-all duration-200 ease-spring hover:-translate-y-0.5 hover:bg-teal hover:text-paper active:translate-y-0 focus-visible:ring-2 focus-visible:ring-teal"
      >
        Back home
        <Icon name="arrow" class="w-4 h-4" />
      </a>
    </div>
  </div>
</BaseLayout>
