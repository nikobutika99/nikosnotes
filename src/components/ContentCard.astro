---
import CategoryTag from './CategoryTag.astro';
import Icon from './Icon.astro';
import { formatDate, coverFor, type CardItem } from '../lib/content';

interface Props {
  item: CardItem;
}
const { item } = Astro.props;
const cover = coverFor(item);
---
<article
  class="card-item group relative flex flex-col overflow-hidden rounded-2xl bg-white shadow-card ring-1 ring-ink/[0.04] transition-all duration-300 ease-spring hover:-translate-y-1 hover:shadow-floating dark:bg-navy dark:ring-white/5"
  data-type={item.type}
  data-category={item.category}
  data-title={item.title.toLowerCase()}
  data-tags={item.tags.join(' ').toLowerCase()}
  data-date={item.date.getTime()}
  data-featured={String(item.featured)}
>
  <a href={item.url} class="block focus-visible:outline-none">
    <!-- Cover with gradient + color treatment (CLAUDE.md image rule) -->
    <div class="relative aspect-[16/10] overflow-hidden">
      <img
        src={cover}
        alt=""
        loading="lazy"
        class="h-full w-full object-cover transition-transform duration-500 ease-spring group-hover:scale-[1.04]"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-ink/60 via-ink/10 to-transparent"></div>
      <div class="absolute inset-0 bg-teal/10 mix-blend-multiply"></div>
      <div class="absolute left-3 top-3">
        <CategoryTag category={item.category} light />
      </div>
    </div>
  </a>

  <div class="flex flex-1 flex-col p-5">
    <a href={item.url}>
      <h3 class="text-lg font-bold leading-snug text-ink transition-colors duration-200 ease-spring group-hover:text-teal dark:text-paper">
        {item.title}
      </h3>
    </a>
    <p class="mt-2 line-clamp-2 text-sm leading-relaxed text-navy/60 dark:text-mist/55">
      {item.description}
    </p>

    <div class="mt-4 flex items-center justify-between border-t border-ink/5 pt-3 dark:border-white/5">
      <span class="flex items-center gap-1.5 text-xs text-navy/45 dark:text-mist/45">
        <Icon name="clock" class="w-3.5 h-3.5" />
        {formatDate(item.date)}
      </span>
      <a
        href={item.url}
        class="inline-flex items-center gap-1 text-xs font-semibold text-growth transition-all duration-200 ease-spring hover:gap-2 hover:text-teal focus-visible:ring-2 focus-visible:ring-teal"
      >
        Read more
        <Icon name="arrow" class="w-3.5 h-3.5" />
      </a>
    </div>
  </div>
</article>
