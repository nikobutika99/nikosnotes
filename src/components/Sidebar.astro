---
import Icon from './Icon.astro';
import { site, nav } from '../site';
import about from '../data/about.json';

interface Props {
  active?: string; // href of the active nav item
}
const { active = '' } = Astro.props;

const isActive = (href: string) =>
  href === '/' ? active === '/' : active.startsWith(href);
---
<aside
  id="sidebar"
  class="grain fixed inset-y-0 left-0 z-40 flex w-[264px] -translate-x-full flex-col overflow-y-auto bg-ink px-5 pb-6 pt-7 text-mist/70 transition-transform duration-300 ease-spring lg:translate-x-0"
>
  <!-- Brand wordmark -->
  <a href="/" class="group relative z-10 mb-8 inline-flex flex-col px-1">
    <span class="font-display text-3xl font-bold tracking-tightest text-paper">Niko's</span>
    <span class="mt-1 h-[3px] w-9 rounded-full bg-growth transition-all duration-300 ease-spring group-hover:w-14"></span>
    <span class="mt-2 text-[0.7rem] font-medium uppercase tracking-[0.18em] text-teal">notes</span>
  </a>

  <!-- Profile mini -->
  <a
    href="/about"
    class="relative z-10 mb-7 flex items-center gap-3 rounded-2xl bg-white/[0.04] p-3 ring-1 ring-white/5 transition-colors duration-200 ease-spring hover:bg-white/[0.07]"
  >
    <img
      src={about.portrait || site.avatar}
      alt={site.author}
      width="44"
      height="44"
      class="h-11 w-11 rounded-full object-cover ring-2 ring-teal/40"
    />
    <span class="min-w-0">
      <span class="block truncate text-sm font-semibold text-paper">{site.author}</span>
      <span class="block truncate text-xs text-mist/50">{site.email}</span>
    </span>
  </a>

  <!-- Primary nav -->
  <nav class="relative z-10 flex flex-1 flex-col gap-1">
    {nav.map((item) => (
      <a
        href={item.href}
        aria-current={isActive(item.href) ? 'page' : undefined}
        class:list={[
          'group flex items-center gap-3 rounded-xl px-3 py-2.5 text-sm font-medium transition-all duration-200 ease-spring focus-visible:ring-2 focus-visible:ring-teal',
          isActive(item.href)
            ? 'bg-teal/15 text-paper'
            : 'text-mist/60 hover:bg-white/5 hover:text-paper',
        ]}
      >
        <span class:list={[isActive(item.href) ? 'text-teal' : 'text-mist/45 group-hover:text-teal']}>
          <Icon name={item.icon} />
        </span>
        {item.label}
      </a>
    ))}
  </nav>

  <!-- Dark mode toggle -->
  <button
    id="theme-toggle"
    type="button"
    class="relative z-10 mt-6 flex items-center justify-between rounded-xl px-3 py-2.5 text-sm font-medium text-mist/60 transition-colors duration-200 ease-spring hover:bg-white/5 hover:text-paper focus-visible:ring-2 focus-visible:ring-teal"
    aria-label="Toggle dark mode"
  >
    <span class="flex items-center gap-3">
      <span class="text-mist/45"><Icon name="moon" class="w-5 h-5 hidden dark:block" /><Icon name="sun" class="w-5 h-5 dark:hidden" /></span>
      <span>Dark mode</span>
    </span>
    <span class="relative h-5 w-9 rounded-full bg-white/10 transition-colors duration-200 ease-spring dark:bg-growth/80">
      <span class="absolute left-0.5 top-0.5 h-4 w-4 rounded-full bg-mist shadow transition-transform duration-200 ease-spring dark:translate-x-4"></span>
    </span>
  </button>
</aside>

<!-- Mobile overlay -->
<div
  id="sidebar-overlay"
  class="fixed inset-0 z-30 hidden bg-ink/50 backdrop-blur-sm lg:hidden"
></div>

<script>
  // Mobile drawer open/close
  const sidebar = document.getElementById('sidebar');
  const overlay = document.getElementById('sidebar-overlay');
  const openBtn = document.getElementById('sidebar-open');
  const open = () => {
    sidebar?.classList.remove('-translate-x-full');
    overlay?.classList.remove('hidden');
  };
  const close = () => {
    sidebar?.classList.add('-translate-x-full');
    overlay?.classList.add('hidden');
  };
  openBtn?.addEventListener('click', open);
  overlay?.addEventListener('click', close);

  // Theme toggle
  const toggle = document.getElementById('theme-toggle');
  toggle?.addEventListener('click', () => {
    const isDark = document.documentElement.classList.toggle('dark');
    localStorage.setItem('theme', isDark ? 'dark' : 'light');
  });
</script>
